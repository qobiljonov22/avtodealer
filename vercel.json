{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=3600" }
      ]
    }
  ],
  "redirects": [
    { "source": "/cms", "destination": "/admin/", "permanent": false },
    { "source": "/cms/", "destination": "/admin/", "permanent": false },
    { "source": "/wp-admin-notice", "destination": "/admin/", "permanent": false },
    { "source": "/wp-admin-notice/", "destination": "/admin/", "permanent": false }
  ]
}
